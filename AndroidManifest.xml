<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.zishu.ai"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="29" />

    <!-- Internet: Zishu website/backend ke liye -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Native voice recognition ke liye -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Contacts access -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- SMS -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Phone calls -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application
        android:icon="@drawable/zishu_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <!-- First-launch intro video -->
        <activity
            android:name="com.zishu.ai.IntroActivity"
            android:label="@string/app_name"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Main Zishu AI -->
        <activity
            android:name="com.zishu.ai.MainActivity"
            android:label="@string/app_name"
            android:exported="false" />

    </application>

</manifest>
